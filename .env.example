# Copy to .env.local for local development.

# The local Postgres from `pnpm db:up`. In production, set this in Dokploy to
# the Postgres service's *internal* connection URL.
DATABASE_URL=postgres://celtivo:celtivo@localhost:5432/celtivo

# Shared with the inbound Email Worker (workers/inbound-email), which sends it as a bearer
# token to POST /api/inbound/email. Generate one with `openssl rand -hex 32`; set the same
# value in Dokploy and with `pnpm wrangler secret put INBOUND_EMAIL_SECRET -c workers/inbound-email/wrangler.jsonc`.
INBOUND_EMAIL_SECRET=dev-inbound-secret

# Extraction job (features/extraction). Without ANTHROPIC_API_KEY the job doesn't start and
# emails stay "received" until it does. EXTRACTION_MODEL defaults to claude-haiku-5-5;
# EXTRACTION_DAILY_AI_CAP (default 50) limits Claude calls per trip per day.
# EXTRACTION_JOB=off disables the job, e.g. on a second instance.
ANTHROPIC_API_KEY=
# EXTRACTION_MODEL=claude-haiku-5-5

# Where the app reads raw emails back from. Unset locally: it reads .inbound/ instead.
# R2_ENDPOINT is the bucket's EU S3 endpoint, https://<account-id>.eu.r2.cloudflarestorage.com;
# the keys come from an R2 API token with Object Read on celtivo-inbound only.
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=celtivo-inbound
